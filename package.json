{
  "name": "soiree-jeux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site de jeux pour la team : lobby, comptes, admin, chat et jeux multijoueurs.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "seed": "node server/seed.js",
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "nanoid": "^5.0.7",
    "pg": "^8.13.0",
    "socket.io": "^4.7.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
